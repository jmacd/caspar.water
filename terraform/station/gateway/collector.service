[Unit]
Description=Caspar Water Gateway Collector
# Do not write beneath an unmounted archive. A failed mount prevents startup;
# collector-retry.timer retries dependency failures that Restart= cannot cover.
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/home/system
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStart=/home/jmacd/bin/collector.sh --config /home/jmacd/etc/config.yaml

[Install]
WantedBy=multi-user.target
