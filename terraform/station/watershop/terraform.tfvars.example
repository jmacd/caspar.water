# Watershop terraform variables
#
# Copy to terraform.tfvars and fill in secrets.
# This file is gitignored — credentials stay local.

# SSH connection
user     = "jmacd"
host     = "watershop.casparwater.us"
ssh_key  = "~/.ssh/id_ed25519"

# MinIO (local to watershop)
minio_endpoint   = "http://localhost:9000"
minio_access_key = ""
minio_secret_key = ""

# Production publishes exclusively to the -0002 Azure containers.
azure_storage_account = ""
azure_tenant_id        = ""
azure_producer_credentials = {
  noyo-prod   = { client_id = "", client_secret = "" }
  septic-prod = { client_id = "", client_secret = "" }
  water-prod  = { client_id = "", client_secret = "" }
}
azure_site_credentials = {
  client_id     = ""
  client_secret = ""
}

# Keep false while initializing or resetting production. Enable only after
# controlled producer and site cycles have succeeded.
activate_production_timers = false

# Weekly report email remains disabled until the verified ACS domain is ready.
# Keep the recipient and access key only in this ignored tfvars file.
weekly_report_email_instances = []
weekly_report_email_credentials = {
  endpoint   = ""
  access_key = ""
  recipient  = ""
}

# HydroVu API (noyo pond)
hydrovu_key_id    = ""
hydrovu_key_value = ""

# NFS mount paths (septic and water data sources)
water_data_dir  = "/home/shared/water/archive/data"
septic_data_dir = "/home/shared/septic/archive/data"

# Noyo archive data (laketech HTML, archived HydroVu exports)
noyo_archive_dir = "/home/shared/noyo/archive/data"
