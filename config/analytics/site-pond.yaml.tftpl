# Rendered by Terraform with literal site paths; imported queries need no site env.
version: v1
kind: mkdir
metadata:
  path: /analytics/${site}/raw
---
version: v1
kind: mknod
metadata:
  path: /etc/ingest-${site}
spec:
  factory: logfile-ingest
  config:
    archived_pattern: ${log_root}/${site}/beacons-*.log
    active_pattern: ${log_root}/${site}/beacons.log
    pond_path: /analytics/${site}/raw
    timestamp_field: ts
    timestamp_unit: rfc3339
---
version: v1
kind: mknod
metadata:
  path: /analytics/${site}/views
spec:
  factory: sql-derived-series
  config:
    patterns:
      source: jsonlogs:///analytics/${site}/raw/beacons*.log
    locality:
      type: timestamp-local
      event_time: timestamp
      input_event_time: ts
    query: >-
      SELECT CAST(ts AS TIMESTAMP) AS timestamp, site_id, page_uri
      FROM source
      WHERE schema_version = '1' AND event = 'pageview' AND status = '204'
        AND site_id = '${site}-${environment}'
---
version: v1
kind: mknod
metadata:
  path: /analytics/${site}/daily
spec:
  factory: temporal-reduce-series
  config:
    in_pattern: series:///analytics/${site}/views
    time_column: timestamp
    group_by: [site_id, page_uri]
    resolution: 1d
    aggregations:
      - type: count
        columns: ["*"]
    output_aliases:
      timestamp.count: views
---
version: v1
kind: mknod
metadata:
  path: /analytics/${site}/public
spec:
  factory: sql-derived-series
  config:
    patterns:
      daily: series:///analytics/${site}/daily
      pages: file+table:///analytics/${site}/pages.parquet
    query: >-
      WITH inventory AS (
        SELECT site_id, page_uri,
          CASE WHEN COUNT(DISTINCT section) = 1 THEN MIN(section) END AS section
        FROM pages GROUP BY site_id, page_uri
      )
      SELECT daily.timestamp,
        COALESCE(inventory.section, 'Other / unclassified') AS section,
        SUM(daily.views) AS views
      FROM daily LEFT JOIN inventory
        ON daily.site_id = inventory.site_id AND daily.page_uri = inventory.page_uri
      WHERE daily.timestamp >= date_trunc('day', now()) - INTERVAL '29 days'
        AND daily.timestamp < date_trunc('day', now()) + INTERVAL '1 day'
      GROUP BY daily.timestamp, COALESCE(inventory.section, 'Other / unclassified')
---
version: v1
kind: mknod
metadata:
  path: /etc/site-${site}
spec:
  factory: sitegen
  config:
    site:
      title: "${title} activity"
      base_url: /analytics/${site}/
      home_url: /
    exports:
      - name: counts
        pattern: /analytics/${site}/public
    routes:
      - name: home
        type: static
        slug: ""
        page: /analytics/templates/overview.md
        export: counts
    sidebar:
      - label: Caspar Water
        href: /
      - label: Noyo Harbor
        href: /noyo-harbor/
      - label: Caspar activity
        href: /analytics/caspar/
      - label: Noyo activity
        href: /analytics/noyo/
---
